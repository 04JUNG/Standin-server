# ── VLM ──
VLM_PROVIDER=mock                 # mock | gemini | openai
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Gemini 호출 1회 상한(ms). 20초는 짧아서 2026-08-19 프로덕션 분석이 전부 이 선에서 잘렸다.
# timeout은 재시도 대상이 아니므로(비용 중복 방지) 데드라인 자체를 넉넉히 잡는다.
GEMINI_REQUEST_TIMEOUT_MS=45000
GEMINI_MAX_ATTEMPTS=3                 # 429/503만 이 범위에서 재시도
# VLM 단계 전체(재시도 포함) 예산(초). BFF 분석 상한 120초 안에서 검출·포즈·검색도
# 끝나야 하므로, 남은 예산으로 한 번 더 시도할 수 없으면 재시도를 멈춘다.
GEMINI_TOTAL_BUDGET_SECONDS=75
# 재시도 1회에 최소한 이만큼은 남아 있어야 시도한다. 시도의 timeout은 남은 예산에 맞춰 줄어든다.
GEMINI_MIN_ATTEMPT_SECONDS=10
# 1차 모델이 503으로 소진되면 남은 예산으로 태울 다른 모델(쉼표 구분). 503은 모델별
# 용량 풀 문제라 같은 모델 재시도는 실패가 상관돼 있다. 비우면 폴백 없음.
# ⚠ 바꾸기 전에 scripts/vlm_probe.py로 실제 키에서 되는지 확인할 것(404 = 500 + 알림).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# 사고 토큰 예산. 이 단계는 열거형 태깅이라 추론이 필요 없다. **1차 모델에만** 적용된다.
#   0=끔(기본) / -1=동적 / none=필드를 안 보냄(lite 계열은 이 필드를 400으로 거부)
GEMINI_THINKING_BUDGET=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── 포즈/검출 ──
POSE_BACKEND=mock                 # mock | rtmlib

# ── 검색/신뢰도 ──
USE_RERANK=1
DISTANCE=pos                      # pos | angle | hybrid
FALLBACK_DISTANCE=0.45            # 아래 전용값 미지정 시 쓰는 호환 기본값
# metric×coverage 전용값은 고정 평가셋으로 보정한 뒤 설정한다.
# FALLBACK_POS_FULL=0.45
# FALLBACK_POS_REDUCED=0.45
# FALLBACK_ANGLE_FULL=0.45
# FALLBACK_ANGLE_REDUCED=0.45
# FALLBACK_HYBRID_FULL=0.45
# FALLBACK_HYBRID_REDUCED=0.45
MIN_SKELETON_SCORE=0.2            # 슬롯 미사용 레거시 경로의 평균 score 게이트
SKELETON_KPT_THRESHOLD=0.3
SKELETON_TORSO_MIN_BOX_RATIO=0.05
SKELETON_TORSO_WIDTH_RATIO_MAX=2.50
SKELETON_ARM_SEGMENT_RATIO_MAX=1.80
SKELETON_LEG_SEGMENT_RATIO_MAX=2.50
SKELETON_ADJACENT_SEGMENT_RATIO_MAX=3.50
SLOT_ASSIGNMENT_MAX_COST=0.85
SLOT_ASSIGNMENT_AMBIGUITY_MARGIN=0.08
SLOT_DUPLICATE_IOU=0.70
SLOT_DUPLICATE_KEYPOINT_DISTANCE=0.08
SLOT_OWNER_PADDING=0.15
SLOT_CROSS_OWNER_MAX_IOU=0.50
SLOT_CROP_MAX_PER_CUT=2
SLOT_CROP_PADDING=0.20
# SLOT_STABILITY_TOP1_ANGLE_MAX=  # 평가셋 보정 전에는 미설정(가족 overlap만 진단)

# ── refine ──
REFINE_ENABLED=1
REFINE_LIMBS=arms                 # P2 이동량 게이트 전에는 팔만이 안전 기본값
REFINE_AXIS_OBS=1                 # P1a: 안 보이는 회전축의 베이스 정규화 강화
REFINE_AXIS_LAMBDA_MAX_MULT=100   # 축별 lambda 강화 배수 상한
REFINE_SVD_OBS=1                  # P1b: 축 조합 null-space를 SVD 기저로 고정
REFINE_SVD_LAMBDA_MAX_MULT=2      # 실 러프 15개 스윕에서 손 방향/손목 이동 균형 최선
REFINE_MOVE_GATE=0                # P2 하드 게이트 보류. 0이어도 이동량 진단은 기록
REFINE_MAX_MOVE_MEAN=0.20         # 팔꿈치·손목/무릎·발목 평균(torso 단위)
REFINE_MAX_MOVE_MAX=0.35          # 손목·발목 말단 이동량 상한(torso 단위)
REFINE_COLLISION_GATE=1           # P3a: 새 깊은 손·전완-몸통 관통 사지만 복구
REFINE_COLLISION_TORSO_SHOULDER_SCALE=0.38
REFINE_COLLISION_TORSO_HIP_SCALE=0.45
REFINE_COLLISION_ARM_RADIUS=0.035
REFINE_COLLISION_HAND_RADIUS=0.025
REFINE_COLLISION_LEG_RADIUS=0.045
REFINE_COLLISION_SAMPLES=9
REFINE_COLLISION_MIN_DEPTH=0.05   # torso 단위. 실 러프 양성/음성 probe로 고정
REFINE_COLLISION_WORSEN_DELTA=0.01

# ── refine v2.5 safe-aggressive (제품 기본) ──
REFINE_V2_ENABLED=1               # 0은 비상 복구·v1 비교 실험에서만 사용
REFINE_DEFAULT_MODE=aggressive    # 요청 mode 생략 시 safe aggressive attempt
REFINE_V25_SELECTOR_ENABLED=1     # 0이면 aggressive 후보를 절대 반환하지 않음
REFINE_V25_JOINT_NME_EPSILON=0.000001
REFINE_V25_ENDPOINT_NME_EPSILON=0.000001
REFINE_V25_PAIR_EPSILON=0.000001
REFINE_V25_CONTACT_EPSILON=0.00000001
REFINE_V25_JOINT_NME_WEIGHT=0.15
REFINE_V25_PARTIAL_ALPHAS=0.75,0.5,0.25
REFINE_V25_SKIP_INACTIVE_AGGRESSIVE=1
REFINE_V25_INACTIVE_SKIP_BUDGET_FRACTION=0.25
REFINE_V25_FINAL_CHECK_RESERVE_SECONDS=0.15
REFINE_V25_AGGRESSIVE_MIN_REMAINING_SECONDS=0.75
REFINE_GAIN_EPSILON=0.0001        # 수치 노이즈만 거르는 양의 gain 하한
REFINE_V2_LOWER_BODY=1            # v2 안에서 coverage/관측 게이트 통과 다리 허용
REFINE_V2_TORSO=0                 # 하체 holdout 통과 전에는 몸통 단계 OFF
REFINE_V2_ENDPOINT_WEIGHT=0.35
REFINE_V2_ENDPOINT_HUBER_DELTA=0.15
REFINE_V2_MOVE_WEIGHT=0.08
REFINE_V2_COLLISION_WEIGHT=0.10
REFINE_V2_ANATOMY_WEIGHT=0.05
REFINE_V2_HAND_LEG_MIN_DEPTH=0.01
REFINE_V2_HAND_LEG_WORSEN_DELTA=0.005
REFINE_V2_LOWER_PAIR_WEIGHT=0.35
REFINE_V2_LOWER_PAIR_MIN_GAP_DELTA=0.02
REFINE_V2_FORESHORTENING_DIRECTION_SCALE=0.25
REFINE_V2_HAND_PAIR_WEIGHT=0.80
REFINE_V2_HAND_PAIR_MIDPOINT_WEIGHT=0.60
REFINE_V2_HAND_PAIR_MIN_GAP_DELTA=0.02
REFINE_V2_LAP_CONTACT_2D_THRESHOLD=0.25
REFINE_V2_LAP_CONTACT_WEIGHT=1.50
REFINE_V2_LAP_CONTACT_MIN_CLEARANCE=-0.003
REFINE_V2_LAP_CONTACT_MAX_CLEARANCE=0.02
REFINE_V2_AGGRESSIVE_LOWER_PAIR_WEIGHT=0.90
REFINE_V2_ANKLE_COUNTER_MAX_DELTA_DEG=18
REFINE_V253_SINGLE_LEG_EXTENSION_ENABLED=1
REFINE_V253_STRAIGHT_ANGLE_MIN_DEG=160
REFINE_V253_EXTENSION_DELTA_MIN_DEG=15
REFINE_V253_EXTENSION_DELTA_MAX_DEG=45
REFINE_V253_UP_LEG_MAX_DELTA_DEG=18
REFINE_POSE_QUARANTINE_PATH=config/refine_pose_quarantine.v1.json
REFINE_V2_TORSO_MAX_DELTA_DEG=8
REFINE_V2_BLEND_ALPHAS=1.0,0.75,0.5,0.25
REFINE_V2_FOOT_DIRECTION_DEG=12
REFINE_V2_GROUND_TOLERANCE=0.08
REFINE_TIMEOUT_SECONDS=5.0        # 초과 시 조정본을 버리고 베이스 BVH 반환

# ── 실행 환경 ──
APP_ENV=development               # development | production
DEPLOYMENT_VERSION=development    # 평가에서는 불변 배포 ID로 설정
SOURCE_REVISION=                  # 평가에서는 v1/v2가 공유하는 git/image revision 필수
# production에서는 합성 라이브러리 폴백과 mock 백엔드를 막는다(가짜 후보 서빙 방지).

# ── 데이터 경로 ──
DATA_DIR=data
DB_PATH=data/poses.db
BVH_DIR=                          # 실 BVH 폴더(build_db 시). 예: data/bvh
INDEX_PATH=data/index.pkl

# ── 라이브러리 프로비저닝(배포 전용) ──
# 라이브러리는 재배포 금지 조항 때문에 이미지·저장소에 넣지 않는다.
# 배포 환경에서는 기동 시 여기서 번들(tar.gz)을 받아 DATA_DIR에 푼다.
# 번들 루트: poses.db · index.pkl(선택) · bvh/(선택) · thumbs/(선택)
#   배포: python scripts/deploy_pose_library.py data/   ← 검증·업로드·재기동을 한 번에
#   수동: tar -czf v1.tar.gz -C data poses.db index.pkl bvh thumbs
#         aws s3 cp v1.tar.gz s3://<bucket>/pose-library/v1.tar.gz
# s3://는 boto3 + ECS 태스크 역할을 쓴다(키를 환경에 두지 않는다).
POSE_LIBRARY_URI=                 # 예: s3://standin-assets/pose-library/v1.tar.gz

# ── 관측성(로그·장애 알림) ──
# 설계 정본: 마스터독스 「관측성 — 로그·모니터링·디스코드 알림」
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR. 출력은 항상 JSON 한 줄.
# 디스코드 웹훅. ⚠ URL 자체가 비밀이다 — URL을 아는 누구나 그 채널에 글을 쓸 수 있다.
# 배포에서는 Secrets Manager의 standin/discord에서 주입한다.
# 비어 있으면 알림기는 조용히 no-op이다(로컬은 웹훅 없이 그대로 돈다).
DISCORD_WEBHOOK_ALERT=            # P1 — 기동 실패·프로덕션 mock 폴백
DISCORD_WEBHOOK_WARN=             # P2 — 처리되지 않은 예외
DISCORD_WEBHOOK_OPS=              # P3 — 기동 완료·요약
DISCORD_ALERT_MENTION=            # P1에 붙일 멘션(@here 등). 비우면 멘션 없음.
ALERT_FLUSH_SECONDS=10            # 배치 창. 이 안의 알림을 한 메시지로 묶는다.
ALERT_SUPPRESS_SECONDS=300        # 같은 키를 다시 보내지 않는 시간(재발은 세었다가 ×N으로 보고)
ALERT_MAX_PER_FLUSH=5             # 한 메시지의 임베드 상한. 초과분은 "외 N종"으로 접는다.
POSE_LIBRARY_VERSION=v1           # 불변 bundle/DB manifest 버전
