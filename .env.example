# ── VLM ──
VLM_PROVIDER=mock                 # mock | gemini | openai
GEMINI_API_KEY=                   # gemini 쓸 때만. ⚠ 실제 키는 .env에(커밋 금지)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── 포즈/검출 ──
POSE_BACKEND=mock                 # mock | rtmlib

# ── 검색/신뢰도 ──
USE_RERANK=1
FALLBACK_DISTANCE=0.45            # Top-1 거리 임계(초과=저신뢰 폴백). 실데이터로 보정
MIN_SKELETON_SCORE=0.2            # 스켈레톤 평균 score 미만=추출 실패

# ── 실행 환경 ──
APP_ENV=development               # development | production
# production에서는 합성 라이브러리 폴백과 mock 백엔드를 막는다(가짜 후보 서빙 방지).

# ── 데이터 경로 ──
DATA_DIR=data
DB_PATH=data/poses.db
BVH_DIR=                          # 실 BVH 폴더(build_db 시). 예: data/bvh
INDEX_PATH=data/index.pkl

# ── 라이브러리 프로비저닝(배포 전용) ──
# 라이브러리는 재배포 금지 조항 때문에 이미지·저장소에 넣지 않는다.
# 배포 환경에서는 기동 시 여기서 번들(tar.gz)을 받아 DATA_DIR에 푼다.
# 번들 루트: poses.db · index.pkl(선택) · bvh/(선택)
#   만들기: tar -czf v1.tar.gz -C data poses.db index.pkl bvh
#   올리기: aws s3 cp v1.tar.gz s3://<bucket>/pose-library/v1.tar.gz
# s3://는 boto3 + ECS 태스크 역할을 쓴다(키를 환경에 두지 않는다).
POSE_LIBRARY_URI=                 # 예: s3://standin-assets/pose-library/v1.tar.gz
