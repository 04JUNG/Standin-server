# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm

ARG TARGETARCH

ENV BLENDER_VERSION=5.2.0 \
    BLENDER_ARCHIVE=blender-5.2.0-linux-x64.tar.xz \
    BLENDER_SHA256=96f6c181a30f4950607839dc84d42a354b250d8a0231b098b59b7bc69c351c48 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/blender:/usr/local/bin:/usr/bin:/bin \
    BLENDER_BINARY=/opt/blender/blender \
    BLENDER_EXPECTED_VERSION=5.2.0 \
    BLENDER_EXPECTED_BUILD_HASH=fbe6228777e7 \
    CONVERTER_CHARACTER_REGISTRY=/app/config/characters.example.json \
    CONVERTER_TEMP_ROOT=/tmp/standin-converter \
    BLENDER_USER_RESOURCES=/tmp/blender-user

# The frozen solver was approved only on Blender 5.2.0 Linux/amd64. Download the
# official archive, verify it before extraction, and keep only runtime libraries.
RUN test "$TARGETARCH" = "amd64" \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        xz-utils \
        libdbus-1-3 \
        libegl1 \
        libfontconfig1 \
        libgl1 \
        libglib2.0-0 \
        libice6 \
        libsm6 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libx11-6 \
        libx11-xcb1 \
        libxcursor1 \
        libxfixes3 \
        libxi6 \
        libxinerama1 \
        libxkbcommon0 \
        libxrandr2 \
        libxrender1 \
        libxxf86vm1 \
    && curl --fail --location --show-error \
        --output "/tmp/${BLENDER_ARCHIVE}" \
        "https://download.blender.org/release/Blender5.2/${BLENDER_ARCHIVE}" \
    && echo "${BLENDER_SHA256}  /tmp/${BLENDER_ARCHIVE}" | sha256sum --check --strict \
    && mkdir --parents /opt/blender \
    && tar --extract --xz --file "/tmp/${BLENDER_ARCHIVE}" \
        --directory /opt/blender --strip-components=1 \
    && rm "/tmp/${BLENDER_ARCHIVE}" \
    && apt-get purge --yes curl xz-utils \
    && apt-get autoremove --yes \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/blender/blender --version

WORKDIR /app

COPY requirements-converter.txt /app/requirements-converter.txt
RUN python -m pip install --requirement /app/requirements-converter.txt

# Runtime allowlist: no inference source, tests, QA snapshots, or user artifacts.
COPY converter/__init__.py /app/converter/__init__.py
COPY converter/ankle_policy.json /app/converter/ankle_policy.json
COPY converter/bone_map.py /app/converter/bone_map.py
COPY converter/convert.py /app/converter/convert.py
COPY converter/protocol.py /app/converter/protocol.py
COPY converter/retarget.py /app/converter/retarget.py
COPY converter/worker.py /app/converter/worker.py
COPY converter_api/__init__.py /app/converter_api/__init__.py
COPY converter_api/app.py /app/converter_api/app.py
COPY converter_api/registry.py /app/converter_api/registry.py
COPY converter_api/runner.py /app/converter_api/runner.py
COPY converter_api/schemas.py /app/converter_api/schemas.py
COPY config/characters.example.json /app/config/characters.example.json

RUN /usr/sbin/useradd --system --uid 10001 --create-home --home-dir /home/standin standin \
    && mkdir --parents /characters "$CONVERTER_TEMP_ROOT" "$BLENDER_USER_RESOURCES" \
    && chown --recursive standin:standin \
        /app /characters /home/standin "$CONVERTER_TEMP_ROOT" "$BLENDER_USER_RESOURCES" \
    && python -c "import importlib.util,sys; sys.exit(0 if importlib.util.find_spec('bpy') is None else 1)"

USER 10001:10001

EXPOSE 8001

CMD ["uvicorn", "converter_api.app:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
