{
  "$defs": {
    "BodyAssetRef": {
      "additionalProperties": true,
      "properties": {
        "body_id": {
          "minLength": 1,
          "title": "Body Id",
          "type": "string"
        },
        "body_version": {
          "minLength": 1,
          "title": "Body Version",
          "type": "string"
        },
        "asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Sha256",
          "type": "string"
        },
        "rig_version": {
          "minLength": 1,
          "title": "Rig Version",
          "type": "string"
        },
        "measurement_version": {
          "minLength": 1,
          "title": "Measurement Version",
          "type": "string"
        }
      },
      "required": [
        "body_id",
        "body_version",
        "asset_sha256",
        "rig_version",
        "measurement_version"
      ],
      "title": "BodyAssetRef",
      "type": "object"
    },
    "BodyExportAssignment": {
      "additionalProperties": false,
      "properties": {
        "person_index": {
          "minimum": 0,
          "title": "Person Index",
          "type": "integer"
        },
        "person_id": {
          "title": "Person Id",
          "type": "string"
        },
        "selection_revision": {
          "minimum": 0,
          "title": "Selection Revision",
          "type": "integer"
        },
        "body": {
          "$ref": "#/$defs/BodyAssetRef"
        },
        "pose": {
          "$ref": "#/$defs/RenderPoseRef"
        }
      },
      "required": [
        "person_index",
        "person_id",
        "selection_revision",
        "body",
        "pose"
      ],
      "title": "BodyExportAssignment",
      "type": "object"
    },
    "ExportItem": {
      "description": "동원이 실제로 소비하는 항목(DB에서 강화됨).",
      "properties": {
        "person_index": {
          "title": "Person Index",
          "type": "integer"
        },
        "pose_id": {
          "title": "Pose Id",
          "type": "string"
        },
        "bvh_url": {
          "description": "GET으로 1인 BVH 원본을 읽는 경로(단일 소스)",
          "title": "Bvh Url",
          "type": "string"
        },
        "view": {
          "title": "View",
          "type": "string"
        },
        "set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "얽힘 그룹 id. 같은 값끼리 한 장면(상대 위치는 작가)",
          "title": "Set Id"
        },
        "set_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "세트 내 역할(A/B 등). solo면 null",
          "title": "Set Role"
        },
        "tags": {
          "additionalProperties": true,
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "person_index",
        "pose_id",
        "bvh_url",
        "view",
        "tags"
      ],
      "title": "ExportItem",
      "type": "object"
    },
    "ExportOrder": {
      "description": "동원한테 보내는 최종 JSON. item 1개 = 1인 BVH 1개(BVH는 다인 미지원).\nCSP 미러링·축 보정은 동원 단계 책임.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "cut_id": {
          "title": "Cut Id",
          "type": "string"
        },
        "source_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Image"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ExportItem"
          },
          "title": "Items",
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "cut_id",
        "created_at",
        "items"
      ],
      "title": "ExportOrder",
      "type": "object"
    },
    "RenderPoseRef": {
      "additionalProperties": false,
      "properties": {
        "candidate_index": {
          "minimum": 0,
          "title": "Candidate Index",
          "type": "integer"
        },
        "kind": {
          "default": "library",
          "enum": [
            "library",
            "refined"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pose_id": {
          "title": "Pose Id",
          "type": "string"
        },
        "view": {
          "enum": [
            "front",
            "three_quarter",
            "side",
            "back",
            "side_opposite",
            "three_quarter_opposite"
          ],
          "title": "View",
          "type": "string"
        },
        "bvh_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bvh Url"
        },
        "bvh": {
          "anyOf": [
            {
              "maxLength": 2000000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bvh"
        },
        "pose_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pose Sha256",
          "type": "string"
        }
      },
      "required": [
        "candidate_index",
        "pose_id",
        "view",
        "pose_sha256"
      ],
      "title": "RenderPoseRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Proposed BFF envelope retains the unchanged inference ExportOrder 1.0.",
  "properties": {
    "schema_version": {
      "const": "body-export.v1",
      "default": "body-export.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "analysis_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Input Sha256",
      "type": "string"
    },
    "pose_order": {
      "$ref": "#/$defs/ExportOrder"
    },
    "body_assignments": {
      "items": {
        "$ref": "#/$defs/BodyExportAssignment"
      },
      "title": "Body Assignments",
      "type": "array"
    }
  },
  "required": [
    "analysis_input_sha256",
    "pose_order",
    "body_assignments"
  ],
  "title": "BodyExportEnvelope",
  "type": "object"
}
