{
  "$defs": {
    "BodyAssetRef": {
      "additionalProperties": true,
      "properties": {
        "body_id": {
          "minLength": 1,
          "title": "Body Id",
          "type": "string"
        },
        "body_version": {
          "minLength": 1,
          "title": "Body Version",
          "type": "string"
        },
        "asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Sha256",
          "type": "string"
        },
        "rig_version": {
          "minLength": 1,
          "title": "Rig Version",
          "type": "string"
        },
        "measurement_version": {
          "minLength": 1,
          "title": "Measurement Version",
          "type": "string"
        }
      },
      "required": [
        "body_id",
        "body_version",
        "asset_sha256",
        "rig_version",
        "measurement_version"
      ],
      "title": "BodyAssetRef",
      "type": "object"
    },
    "BodyPreview": {
      "additionalProperties": false,
      "properties": {
        "candidate_index": {
          "title": "Candidate Index",
          "type": "integer"
        },
        "pose_id": {
          "title": "Pose Id",
          "type": "string"
        },
        "view": {
          "enum": [
            "front",
            "three_quarter",
            "side",
            "back",
            "side_opposite",
            "three_quarter_opposite"
          ],
          "title": "View",
          "type": "string"
        },
        "source_pose_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Pose Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "data": {
          "description": "base64 PNG of the selected FBX body",
          "title": "Data",
          "type": "string"
        },
        "preview_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preview Sha256",
          "type": "string"
        },
        "width": {
          "const": 256,
          "default": 256,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "const": 256,
          "default": 256,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "candidate_index",
        "pose_id",
        "view",
        "source_pose_sha256",
        "data",
        "preview_sha256"
      ],
      "title": "BodyPreview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "body-preview.v1",
      "default": "body-preview.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "person_id": {
      "title": "Person Id",
      "type": "string"
    },
    "selection_revision": {
      "title": "Selection Revision",
      "type": "integer"
    },
    "body": {
      "$ref": "#/$defs/BodyAssetRef"
    },
    "character_id": {
      "title": "Character Id",
      "type": "string"
    },
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "retarget_version": {
      "title": "Retarget Version",
      "type": "string"
    },
    "renderer_version": {
      "title": "Renderer Version",
      "type": "string"
    },
    "status": {
      "const": "ready",
      "default": "ready",
      "title": "Status",
      "type": "string"
    },
    "previews": {
      "items": {
        "$ref": "#/$defs/BodyPreview"
      },
      "title": "Previews",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "person_id",
    "selection_revision",
    "body",
    "character_id",
    "catalog_sha256",
    "retarget_version",
    "renderer_version",
    "previews"
  ],
  "title": "BodyPreviewResult",
  "type": "object"
}
