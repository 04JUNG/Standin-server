{
  "$defs": {
    "BodyAssetRef": {
      "additionalProperties": true,
      "properties": {
        "body_id": {
          "minLength": 1,
          "title": "Body Id",
          "type": "string"
        },
        "body_version": {
          "minLength": 1,
          "title": "Body Version",
          "type": "string"
        },
        "asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Sha256",
          "type": "string"
        },
        "rig_version": {
          "minLength": 1,
          "title": "Rig Version",
          "type": "string"
        },
        "measurement_version": {
          "minLength": 1,
          "title": "Measurement Version",
          "type": "string"
        }
      },
      "required": [
        "body_id",
        "body_version",
        "asset_sha256",
        "rig_version",
        "measurement_version"
      ],
      "title": "BodyAssetRef",
      "type": "object"
    },
    "RenderPoseRef": {
      "additionalProperties": false,
      "properties": {
        "candidate_index": {
          "minimum": 0,
          "title": "Candidate Index",
          "type": "integer"
        },
        "kind": {
          "default": "library",
          "enum": [
            "library",
            "refined"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pose_id": {
          "title": "Pose Id",
          "type": "string"
        },
        "view": {
          "enum": [
            "front",
            "three_quarter",
            "side",
            "back",
            "side_opposite",
            "three_quarter_opposite"
          ],
          "title": "View",
          "type": "string"
        },
        "bvh_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bvh Url"
        },
        "bvh": {
          "anyOf": [
            {
              "maxLength": 2000000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bvh"
        },
        "pose_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pose Sha256",
          "type": "string"
        }
      },
      "required": [
        "candidate_index",
        "pose_id",
        "view",
        "pose_sha256"
      ],
      "title": "RenderPoseRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "body-render.v1",
      "default": "body-render.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "analysis_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Input Sha256",
      "type": "string"
    },
    "person_id": {
      "title": "Person Id",
      "type": "string"
    },
    "person_index": {
      "minimum": 0,
      "title": "Person Index",
      "type": "integer"
    },
    "selection_revision": {
      "minimum": 0,
      "title": "Selection Revision",
      "type": "integer"
    },
    "selection_source": {
      "enum": [
        "auto",
        "user_override"
      ],
      "title": "Selection Source",
      "type": "string"
    },
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "body": {
      "$ref": "#/$defs/BodyAssetRef"
    },
    "retarget_version": {
      "minLength": 1,
      "title": "Retarget Version",
      "type": "string"
    },
    "renderer_version": {
      "minLength": 1,
      "title": "Renderer Version",
      "type": "string"
    },
    "poses": {
      "items": {
        "$ref": "#/$defs/RenderPoseRef"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Poses",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "analysis_input_sha256",
    "person_id",
    "person_index",
    "selection_revision",
    "selection_source",
    "catalog_sha256",
    "body",
    "retarget_version",
    "renderer_version",
    "poses"
  ],
  "title": "BodyRenderRequest",
  "type": "object"
}
