          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "sourcePath": {
          "type": "string",
          "description": "absolute local path"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "action",
        "localModelId",
        "sourcePath",
        "sourceHash"
      ],
      "additionalProperties": false
    },
    "inspect": {
