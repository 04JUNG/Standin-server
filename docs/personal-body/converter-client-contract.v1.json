{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:standin:local-converter:1",
  "protocolVersion": "standin.local-converter/1",
  "versions": {
    "importerVersion": "personal-import/2",
    "normalizationVersion": "personal-normalize/2",
    "rigMappingVersion": "personal-rig/2",
    "converterVersion": "personal-converter/2",
    "converterFingerprint": "runtime-computed SHA256 of all shipped converter Python and JSON files"
  },
  "transport": {
    "type": "stdio-ndjson",
    "encoding": "UTF-8",
    "stdout": "events only, one JSON object per line",
    "stderr": "diagnostics; never model names or paths",
    "oneActiveJob": true,
    "requestIds": "unique for host lifetime; echoed in every event",
    "eof": "cancel active work and clean staging"
  },
  "runtime": {
    "discovery": [
      "STANDIN_LOCAL_CONVERTER: optional debug-only override to packaged launcher",
      "macOS: <app resources>/local-converter/standin-local-converter",
      "Windows: <app resources>/local-converter/standin-local-converter.cmd"
    ],
    "arguments": [
      "--storage",
      "<absolute app-owned directory>"
    ],
    "manualInstallRequired": false,
    "network": false,
    "CS3C": "Catalog version 2 / reviewed schema family: original skinned geometry, matte source diffuse colors, per-face assignments and UV/normals. Requires separately bundled hash-pinned decoder data. No Modeler/Python/Blender user installation. Missing resource fails explicitly.",
    "manifest": "runtime-manifest.json beside launcher: schemaVersion, protocolVersion, target, launcher, blender, python, files (SHA256), uncompressedBytes, requiresUserInstalledRuntime=false, releaseReady=false; cs3c.enabled and build-only source/hash provenance",
    "launch": "spawn launcher with --storage <absolute app-owned storage>; keep stdin open, parse stdout NDJSON; kill host only after cancel/terminal, EOF cancels child and cleans staging",
    "signing": "Current test candidate is unsigned/unqualified; client must not advertise released support.",
    "resourceMapping": "Builder produces a target-specific resource directory; client copies that directory to resources/local-converter at app build time. Manifest.target records the chosen platform."
  },
  "limits": {
    "sourceBytes": 134217728,
    "poseBytes": 8388608,
    "vertices": 1000000,
    "bones": 512,
    "meshes": 128,
    "workerSeconds": 120,
    "workerMemoryBytes": 2147483648,
    "expandedBytes": 67108864,
    "requestBytes": 65536
  },
  "actions": {
    "hello": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "standin.local-converter/1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "action": {
          "const": "hello"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "action"
      ],
      "additionalProperties": false
    },
    "import": {
