        "cs3c": "boolean: validated decoder resource is bundled"
      },
      "hands": false
    },
    "import": "model manifest (see modelManifest)",
    "inspect": "same model manifest, version and file hash checked",
    "apply": {
      "localModelId": "id",
      "snapshotHash": "sha256 canonical snapshot JSON",
      "snapshot": "cacheIdentity object",
      "artifactPath": "verified FBX",
      "artifactHash": "sha256",
      "validation": "roundtrip report",
      "cacheHit": "boolean; cache retains identical immutable snapshot"
    },
    "export": {
      "localModelId": "id",
      "snapshotHash": "sha256",
      "artifactHash": "sha256",
      "destinationPath": "selected destination"
    },
    "delete": {
      "deleted": true
    },
    "cancel": {
      "targetRequestId": "id",
      "accepted": "boolean; target receives CANCELLED if true before commit"
    }
  },
