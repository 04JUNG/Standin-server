  "events": {
    "progress": {
      "protocolVersion": "standin.local-converter/1",
      "requestId": "same as request",
      "event": "progress",
      "stage": "copying | inspecting | retargeting | validating | committing",
      "progress": "number from 0 to 1"
    },
    "result": {
      "protocolVersion": "standin.local-converter/1",
      "requestId": "same as request",
      "event": "result",
      "result": "action-specific payload"
    },
    "error": {
      "protocolVersion": "standin.local-converter/1",
      "requestId": "same as request, null for malformed envelope",
      "event": "error",
      "error": {
        "code": "one of errors",
        "message": "safe developer diagnostic; map to user copy",
        "details": "object without input paths/names",
        "retryable": "boolean"
      }
    }
  },
  "errors": [
    "PROTOCOL_MISMATCH",
    "INVALID_REQUEST",
    "BUSY",
    "MODEL_EXISTS",
    "MODEL_NOT_FOUND",
    "SOURCE_CHANGED",
    "SOURCE_TOO_LARGE",
    "UNSUPPORTED_FORMAT",
    "CS3C_DECODER_UNAVAILABLE",
    "UNSUPPORTED_CS3C_VERSION",
    "UNSUPPORTED_RIG",
    "INVALID_HIERARCHY",
    "UNSUPPORTED_REST_POSE",
    "INVALID_SKIN",
    "UNSUPPORTED_TRANSFORM",
    "UNSUPPORTED_MATERIAL",
    "UNSUPPORTED_FEATURE",
    "HAND_UNSUPPORTED",
    "LIMIT_EXCEEDED",
    "CANCELLED",
    "TIMEOUT",
    "MEMORY_LIMIT",
    "RUNTIME_UNAVAILABLE",
    "RUNTIME_MISMATCH",
    "CONVERSION_FAILED",
    "ROUNDTRIP_FAILED",
    "SNAPSHOT_MISMATCH",
    "DESTINATION_EXISTS",
    "IO_ERROR"
  ],
  "capability": {
    "supportLevel": "body_only or rejected",
    "bodyPose": "boolean",
    "hands": {
      "left": {
        "supported": false,
        "reason": "NO_FINGER_RIG or UNVALIDATED_FINGER_RIG",
        "fingerBones": "integer"
      },
      "right": {
        "supported": false,
        "reason": "NO_FINGER_RIG or UNVALIDATED_FINGER_RIG",
        "fingerBones": "integer"
      }
    },
    "handChanges": "disabled on both sides until personal finger deformation is validated; preserve original hand shape"
  },
  "trustBoundary": "Client obtains final BVH through authenticated existing candidate validation. selectionId is correlation only, not an authorization token. Worker does not fetch poses, bypass BFF, or upload personal assets.",
  "cacheIdentity": [
    "importerVersion",
    "normalizationVersion",
    "rigMappingVersion",
    "converterVersion",
    "localModelId",
    "sourceHash",
    "poseHash",
    "hands.left",
    "hands.right",
    "orientation",
    "outputMode",
    "converterFingerprint"
  ],
  "commit": "A model appears only after import inspection, FK deformation probe, FBX roundtrip and atomic rename. Errors/cancel never replace an existing model. Export requires immutable snapshotHash and never overwrites a destination.",
  "resultPaths": "absolute device-only paths; never send to telemetry or server",
  "scope": "FBX and CS3C known upright T-pose skinned humanoids with supported solid materials; body-only hands. Textures, nonidentity CS3C mesh transforms, source shading match and general-human CS3C remain unqualified.",
  "results": {
    "hello": {
      "protocolVersion": "standin.local-converter/1",
      "versions": {
        "importerVersion": "personal-import/2",
        "normalizationVersion": "personal-normalize/2",
        "rigMappingVersion": "personal-rig/2",
        "converterVersion": "personal-converter/2",
        "converterFingerprint": "runtime-computed SHA256 of all shipped converter Python and JSON files"
      },
