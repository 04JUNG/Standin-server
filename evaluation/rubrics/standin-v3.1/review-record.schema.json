{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standin per-case reviewer record, handoff draft 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "rubric_id",
    "run_id",
    "result_status",
    "expected_people",
    "returned_people",
    "people",
    "execution_error"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "rubric_id": {
      "const": "standin-deduction-head5-action35"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "result_status": {
      "enum": [
        "returned_all",
        "returned_partial",
        "returned_none",
        "execution_error"
      ]
    },
    "expected_people": {
      "type": "integer",
      "minimum": 1
    },
    "returned_people": {
      "type": "integer",
      "minimum": 0
    },
    "execution_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_person_id",
          "chosen_rank",
          "candidate_id",
          "final_image",
          "final_image_sha256",
          "refine_status",
          "reviewer",
          "criteria"
        ],
        "properties": {
          "reference_person_id": {
            "type": "string",
            "minLength": 1
          },
          "chosen_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "final_image": {
            "type": "string",
            "minLength": 1
          },
          "final_image_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "refine_status": {
            "enum": [
              "returned",
              "not_allowed",
              "not_requested",
              "timeout",
              "failed"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "right_arm",
              "left_arm",
              "right_leg",
              "left_leg",
              "torso",
              "head",
              "action"
            ],
            "properties": {
              "right_arm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "left_arm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "right_leg": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "left_leg": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "torso": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "head": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "match",
                      "mismatch",
                      "unobservable",
                      "uncertain",
                      "not_run"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}