# Linux/amd64 runtime matching the validated local Blender version.
FROM python:3.12-slim-bookworm
ARG TARGETARCH
RUN test "$TARGETARCH" = amd64
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils libgl1 libx11-6 libxi6 libxrender1 libxfixes3 \
    libxkbcommon0 libsm6 libice6 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 \
      https://download.blender.org/release/Blender5.2/blender-5.2.0-linux-x64.tar.xz \
      --output /tmp/blender.tar.xz \
    && echo '96f6c181a30f4950607839dc84d42a354b250d8a0231b098b59b7bc69c351c48  /tmp/blender.tar.xz' | sha256sum --check \
    && tar -xJf /tmp/blender.tar.xz -C /opt \
    && ln -s /opt/blender-5.2.0-linux-x64/blender /usr/local/bin/blender \
    && rm /tmp/blender.tar.xz \
    && blender --version
